{
  "name": "vscode-extension-red-skills",
  "displayName": "RedSkills — redskilled",
  "description": "Surfaces the redskilled host daemon inside VSCode: live Workers with vitals, per-Worker logs, the host event lane, open pull requests, and a notification whenever any of it changes.",
  "version": "4.1.18",
  "private": true,
  "publisher": "reddb-io",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "redskilled",
    "red-skills",
    "afk",
    "daemon",
    "toon"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=out/extension.cjs --minify",
    "build": "pnpm run typecheck && pnpm run bundle",
    "package": "pnpm run build && tsx src/package-vsix.ts",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "redskilled",
          "title": "redskilled",
          "icon": "media/redskilled.svg"
        }
      ]
    },
    "views": {
      "redskilled": [
        {
          "id": "redskilled.workers",
          "name": "Workers"
        },
        {
          "id": "redskilled.events",
          "name": "Host events"
        },
        {
          "id": "redskilled.pullRequests",
          "name": "Pull requests"
        }
      ]
    },
    "commands": [
      {
        "command": "redskilled.refresh",
        "title": "redskilled: Refresh now",
        "icon": "$(refresh)"
      },
      {
        "command": "redskilled.showDashboard",
        "title": "redskilled: Show the dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "redskilled.showWorkerLog",
        "title": "redskilled: Show this Worker's log"
      },
      {
        "command": "redskilled.copyWorkerId",
        "title": "redskilled: Copy the Worker id"
      },
      {
        "command": "redskilled.revealWorkspace",
        "title": "redskilled: Reveal the Worker's workspace"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "redskilled.showDashboard",
          "when": "view == redskilled.workers",
          "group": "navigation"
        },
        {
          "command": "redskilled.refresh",
          "when": "view == redskilled.workers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "redskilled.showWorkerLog",
          "when": "view == redskilled.workers && viewItem == redskilled.worker",
          "group": "inline"
        },
        {
          "command": "redskilled.copyWorkerId",
          "when": "view == redskilled.workers && viewItem == redskilled.worker"
        },
        {
          "command": "redskilled.revealWorkspace",
          "when": "view == redskilled.workers && viewItem == redskilled.worker"
        }
      ]
    },
    "configuration": {
      "title": "redskilled",
      "properties": {
        "redskilled.socketPath": {
          "type": "string",
          "default": "",
          "description": "Pin the daemon's unix socket outright. Empty derives it the way the daemon does (REDSKILLED_SESSION, then XDG_RUNTIME_DIR, then the uid)."
        },
        "redskilled.pollIntervalMs": {
          "type": "number",
          "default": 4000,
          "minimum": 500,
          "description": "How often to read the host."
        },
        "redskilled.renotifyMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "How long one notification key stays silent after it fired."
        },
        "redskilled.notifications.daemonReach": {
          "type": "boolean",
          "default": true,
          "description": "Tell me when the daemon stops answering, comes back, or restarts."
        },
        "redskilled.notifications.workerBirth": {
          "type": "boolean",
          "default": false,
          "description": "Tell me when a Worker is born. Off by default: a busy host would interrupt constantly."
        },
        "redskilled.notifications.workerDeath": {
          "type": "boolean",
          "default": true,
          "description": "Tell me when a Worker ends, and how it ended."
        },
        "redskilled.notifications.budgetPressure": {
          "type": "boolean",
          "default": true,
          "description": "Tell me when a Worker crosses its declared memory ceiling, or is killed over it."
        },
        "redskilled.notifications.budgetPressureAt": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "The fraction of a Worker's declared budget that counts as pressure."
        },
        "redskilled.notifications.staleness": {
          "type": "boolean",
          "default": true,
          "description": "Tell me when the daemon stops measuring inside its staleness window."
        },
        "redskilled.notifications.upgrade": {
          "type": "boolean",
          "default": true,
          "description": "Tell me when a newer redskilled is published, or a major is deliberately held."
        },
        "redskilled.notifications.pullRequests": {
          "type": "boolean",
          "default": true,
          "description": "Tell me when a registered project's open pull-request count goes up."
        }
      }
    }
  },
  "dependencies": {
    "@reddb-io/brand-tokens": "workspace:*",
    "@reddb-io/redskilled": "workspace:*",
    "@reddb-io/redskilled-render": "workspace:*",
    "@reddb-io/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.75.0",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddb-io/red-skills.git",
    "directory": "apps/vscode-extension-redskilled"
  }
}
