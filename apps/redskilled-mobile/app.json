{
  "expo": {
    "name": "Redskilled",
    "slug": "redskilled-mobile",
    "version": "4.1.34",
    "scheme": "redskilled",
    "orientation": "portrait",
    "icon": "./vendor/design-system/platform/icon-512.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080a",
          "image": "./vendor/design-system/marks/reddb-stacked-inverse-h256.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-release-signing"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "io.reddb.redskilled",
      "adaptiveIcon": {
        "backgroundImage": "./vendor/design-system/platform/adaptive-background-432.png",
        "foregroundImage": "./vendor/design-system/platform/adaptive-foreground-432.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./vendor/design-system/platform/icon-192.png"
    }
  }
}
