{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "../../packages/shared/**/*.ts"],
  "comment-exclude": "Shared source is typechecked here (opencode-host imports it); shared *.test.ts run under vitest and resolve their own deps, so they are not compiled by opencode-host's tsc.",
  "exclude": ["../../packages/shared/**/*.test.ts"]
}
