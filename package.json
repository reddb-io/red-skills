{
  "name": "red-skills",
  "version": "3.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "turbo run build --filter=!@reddb-io/red-castle --only",
    "bundle": "turbo run bundle --filter=!@reddb-io/red-castle --only",
    "typecheck": "turbo run typecheck --filter=!@reddb-io/red-castle --only",
    "test": "turbo run test --filter=!@reddb-io/red-castle --only",
    "audit:hooks": "bash scripts/audit-hook-hardening-contract.sh",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-version.mjs",
    "release:tag": "changeset tag",
    "version:sync": "node scripts/sync-version.mjs",
    "version:sync:check": "node scripts/sync-version.mjs --check",
    "release:manifest": "node scripts/release-manifest.mjs",
    "generate-manifests": "node scripts/generate-codex-manifests.mjs && node scripts/generate-gemini-manifests.mjs && node scripts/generate-pi-manifests.mjs",
    "codex:manifests": "node scripts/generate-codex-manifests.mjs",
    "codex:manifests:check": "node scripts/generate-codex-manifests.mjs --check",
    "gemini:manifests": "node scripts/generate-gemini-manifests.mjs",
    "gemini:manifests:check": "node scripts/generate-gemini-manifests.mjs --check",
    "pi:manifests": "node scripts/generate-pi-manifests.mjs",
    "pi:manifests:check": "node scripts/generate-pi-manifests.mjs --check",
    "pi:packages:build": "node scripts/build-pi-packages.mjs",
    "pi:packages:check": "node scripts/build-pi-packages.mjs --check",
    "pi:packages:publish": "node scripts/publish-pi-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.5.4",
    "typescript": "^5.6.0"
  }
}
