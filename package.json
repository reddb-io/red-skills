{
  "name": "red-skills",
  "version": "2.7.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "turbo run build --filter=!@reddb-io/red-castle",
    "bundle": "turbo run bundle --filter=!@reddb-io/red-castle",
    "typecheck": "turbo run typecheck --filter=!@reddb-io/red-castle",
    "test": "turbo run test --filter=!@reddb-io/red-castle",
    "audit:hooks": "bash scripts/audit-hook-hardening-contract.sh",
    "release:manifest": "node scripts/release-manifest.mjs",
    "codex:manifests": "node scripts/generate-codex-manifests.mjs",
    "codex:manifests:check": "node scripts/generate-codex-manifests.mjs --check"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.6.0"
  }
}
