{
  "name": "@reddb-io/benchmark-code-understanding",
  "version": "1.148.2",
  "private": true,
  "description": "Internal A/B benchmark for RedSkills code understanding against CodeGraph and native agent search.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node ../../../scripts/bundle-app.mjs --entry src/cli.ts --outfile ../../../dist/benchmark-code-understanding.bundle.min.mjs --asset benchmark-code-understanding.bundle.min.mjs --minify",
    "build": "pnpm run typecheck && pnpm run bundle",
    "test": "vitest run",
    "dev": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@reddb-io/build-info": "workspace:*",
    "@reddb-io/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
