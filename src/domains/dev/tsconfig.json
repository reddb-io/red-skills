{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "../../shared/**/*.ts"],
  "comment-exclude": "Shared source is typechecked here (dev imports it); shared *.test.ts run under vitest and resolve their own deps, so they are not compiled by dev's tsc.",
  "exclude": ["../../shared/**/*.test.ts"]
}
