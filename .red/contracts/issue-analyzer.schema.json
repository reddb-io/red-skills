{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reddb.io/red-skills/contracts/issue-analyzer.schema.json",
  "title": "AFK Issue-Analyzer Envelope",
  "description": "Runner-neutral envelope produced by the analyze_issue phase. Extends the base AFK task envelope (.red/contracts/afk-task.schema.json) with the analyzer-specific `analysis` object. See .red/contracts/issue-analyzer.md.",
  "type": "object",
  "required": [
    "status",
    "phase",
    "runner",
    "issue_number",
    "scope_summary",
    "non_goals",
    "acceptance_criteria_results",
    "changed_files",
    "verification_commands",
    "verification_results",
    "quality_gate_failures",
    "blocker_reason",
    "next_human_action",
    "remaining_risks",
    "confidence",
    "raw_runner_output_path",
    "analysis"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["completed", "blocked", "escalation_needed"]
    },
    "phase": {
      "const": "analyze_issue"
    },
    "runner": {
      "enum": ["claude", "codex", "hermes"]
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "result", "evidence"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "result": { "const": "unverified" },
          "evidence": { "type": "string" }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "maxItems": 0
    },
    "verification_commands": {
      "type": "array",
      "maxItems": 0
    },
    "verification_results": {
      "type": "array",
      "maxItems": 0
    },
    "quality_gate_failures": {
      "type": "array",
      "maxItems": 0
    },
    "blocker_reason": {
      "type": ["string", "null"]
    },
    "next_human_action": {
      "type": ["string", "null"]
    },
    "remaining_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "raw_runner_output_path": {
      "type": ["string", "null"]
    },
    "analysis": {
      "type": "object",
      "required": [
        "task_type",
        "affected_area",
        "recommended_skills",
        "risk_level",
        "scope_boundaries",
        "acceptance_criteria_map",
        "verification_expectations",
        "open_questions",
        "ambiguity_score"
      ],
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "enum": [
            "feature",
            "bug_fix",
            "refactor",
            "docs",
            "chore",
            "test",
            "contract",
            "infra",
            "unknown"
          ]
        },
        "affected_area": {
          "type": "string",
          "minLength": 1
        },
        "recommended_skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk_level": {
          "enum": ["low", "medium", "high"]
        },
        "scope_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance_criteria_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion", "plan", "verification"],
            "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "minLength": 1 },
              "plan": { "type": "string", "minLength": 1 },
              "verification": { "type": "string", "minLength": 1 }
            }
          }
        },
        "verification_expectations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ambiguity_score": {
          "enum": ["low", "medium", "high"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": {
        "properties": {
          "blocker_reason": { "type": "string", "minLength": 1 },
          "next_human_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "escalation_needed" } } },
      "then": {
        "properties": {
          "next_human_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis": { "properties": { "task_type": { "const": "unknown" } } }
        }
      },
      "then": {
        "properties": {
          "status": { "enum": ["blocked", "escalation_needed"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis": { "properties": { "ambiguity_score": { "const": "high" } } }
        }
      },
      "then": {
        "properties": {
          "status": { "enum": ["blocked", "escalation_needed"] },
          "analysis": {
            "properties": {
              "open_questions": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
