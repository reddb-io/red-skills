{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reddb.io/red-skills/contracts/afk-task.schema.json",
  "title": "AFK Task Envelope",
  "description": "Runner-neutral envelope produced by Claude Code sub-agents, Codex CLI inline phases, or Hermes fallback during a single /afk attempt. See .red/contracts/afk-task.md.",
  "type": "object",
  "required": [
    "status",
    "phase",
    "runner",
    "issue_number",
    "scope_summary",
    "non_goals",
    "acceptance_criteria_results",
    "changed_files",
    "verification_commands",
    "verification_results",
    "quality_gate_failures",
    "blocker_reason",
    "next_human_action",
    "remaining_risks",
    "confidence",
    "raw_runner_output_path"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["completed", "blocked", "escalation_needed"]
    },
    "phase": {
      "enum": ["analyze_issue", "execute_task", "verify_task", "fix_or_escalate", "finalize"]
    },
    "runner": {
      "enum": ["claude", "codex", "hermes"]
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "result", "evidence"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "unverified"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "summary"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "summary": { "type": "string" }
        }
      }
    },
    "quality_gate_failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocker_reason": {
      "type": ["string", "null"]
    },
    "next_human_action": {
      "type": ["string", "null"]
    },
    "remaining_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "raw_runner_output_path": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": {
        "properties": {
          "blocker_reason": { "type": "string", "minLength": 1 },
          "next_human_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "escalation_needed" } } },
      "then": {
        "properties": {
          "next_human_action": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
