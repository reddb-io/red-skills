{
  "name": "red-skills",
  "interface": {
    "displayName": "RedSkills"
  },
  "plugins": [
    {
      "name": "dev",
      "source": {
        "source": "local",
        "path": "./plugins/dev"
      },
      "policy": {
        "installation": "INSTALLED_BY_DEFAULT",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "memory",
      "source": {
        "source": "local",
        "path": "./plugins/memory"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "dependencies": [
        "dev"
      ],
      "category": "Developer Tools"
    },
    {
      "name": "brain",
      "source": {
        "source": "local",
        "path": "./plugins/brain"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "internal",
      "description": "Maintainer-only RedSkills repository operations plugin.",
      "source": {
        "source": "local",
        "path": "./plugins/internal"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    }
  ]
