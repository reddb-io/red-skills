{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["^build"],
      "outputs": ["../../dist/**"]
    },
    "@reddb-io/dev#bundle": {
      "dependsOn": [
        "@reddb-io/build-info#build",
        "@reddb-io/shared#build",
        "@reddb-io/toon#build"
      ],
      "outputs": ["../../dist/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "../../dist/**"]
    }
  }
}
