{
  "name": "@reddb/memory",
  "version": "1.48.1",
  "private": true,
  "description": "reddb.io memory plugin — persistent, queryable memory for code agents. This tracer-bullet slice ships the markdown-only path: a single `memory init` wizard, plus `/memory:store` and `/memory:recall` over plain markdown notes (no RedDB, no graph, no hooks).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "memory": "dist/cli.js",
    "memory-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "baseline:competitive": "tsx src/competitive-baseline.ts",
    "dev": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@reddb-io/sdk": "^1.3.1",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@reddb-io/sdk"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
