{
  "name": "@reddb/memory",
  "version": "1.48.1",
  "private": true,
  "description": "reddb.io memory plugin — persistent, queryable memory for code agents: markdown notes, RedDB graph memory, lifecycle hooks, MCP, and Skill telemetry for self-improvement.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "memory": "dist/cli.js",
    "memory-mcp": "dist/mcp-server.js",
    "red-curate-skill": "dist/curate-skill/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "RED_MEMORY_RECALL_P50_TARGET_MS=250 vitest run tests/recall-latency.test.ts && vitest run --exclude tests/recall-latency.test.ts",
    "baseline:competitive": "tsx src/competitive-baseline.ts --json --human",
    "eval:competitive": "tsx src/competitive-baseline.ts --json --human",
    "eval:competitive:v2": "tsx src/competitive-baseline.ts --v2 --json --human",
    "dev": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@reddb-io/sdk": "1.3.1",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@reddb-io/sdk"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
