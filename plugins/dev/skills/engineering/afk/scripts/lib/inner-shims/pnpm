#!/usr/bin/env bash
# AFK inner-agent pnpm shim — wraps `pnpm test` / `pnpm test:*` (including
# `pnpm -C dir test`, `pnpm --filter x test`, `pnpm run test`) with a hard
# `timeout`. Defeats the wheel-spin pattern where the inner agent starts
# `pnpm test` in the background and then sits in an untimed `until grep`
# poll: if the test runner hangs, the shim's timeout fires and the bg task
# exits, so the polling loop can either match the result or break on a
# subsequent deadline. See issue #192.
#
# Non-test invocations are forwarded to the real `pnpm` unchanged.
#
# Knobs:
#   RED_AFK_TEST_TIMEOUT_S   hard test timeout in seconds (default 300)
#   RED_AFK_TEST_KILL_AFTER_S grace before SIGKILL after timeout (default 30)
#   RED_AFK_PNPM_SHIM_DISABLE  any non-empty value bypasses the shim
set -u

SHIM_SELF="${BASH_SOURCE[0]}"
SHIM_DIR="$(cd "$(dirname "$SHIM_SELF")" && pwd)"

# Rebuild PATH without our shim dir so `command -v pnpm` resolves the real one.
_strip_shim_from_path() {
  local in=":$1:" out
  out="${in//:${SHIM_DIR}:/:}"
  out="${out#:}"; out="${out%:}"
  printf '%s\n' "$out"
}

CLEAN_PATH="$(_strip_shim_from_path "$PATH")"
REAL_PNPM="$(PATH="$CLEAN_PATH" command -v pnpm 2>/dev/null || true)"
if [[ -z "$REAL_PNPM" || "$REAL_PNPM" == "$SHIM_SELF" ]]; then
  echo "red-afk pnpm shim: real pnpm not found on PATH" >&2
  exit 127
fi

if [[ -n "${RED_AFK_PNPM_SHIM_DISABLE:-}" ]]; then
  exec env PATH="$CLEAN_PATH" "$REAL_PNPM" "$@"
fi

# Detect a test invocation. Any positional arg of the form `test` or
# `test:*` flips the switch — covers `pnpm test`, `pnpm run test`,
# `pnpm -C svc-x test`, `pnpm --filter=x test:integration`, etc.
is_test=0
for arg in "$@"; do
  case "$arg" in
    test|test:*) is_test=1; break ;;
  esac
done

if [[ "$is_test" -eq 1 ]] && command -v timeout >/dev/null 2>&1; then
  timeout_s="${RED_AFK_TEST_TIMEOUT_S:-300}"
  kill_after_s="${RED_AFK_TEST_KILL_AFTER_S:-30}"
  exec env PATH="$CLEAN_PATH" timeout --kill-after="${kill_after_s}" "${timeout_s}" "$REAL_PNPM" "$@"
fi

exec env PATH="$CLEAN_PATH" "$REAL_PNPM" "$@"
